{
  "name": "filescope",
  "private": true,
  "version": "0.5.0",
  "description": "FileScope desktop application by Veilbyte",
  "author": "Veilbyte",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Veilbyte/FileScope.git"
  },
  "homepage": "https://github.com/Veilbyte/FileScope",
  "bugs": {
    "url": "https://github.com/Veilbyte/FileScope/issues"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @filescope/desktop dev",
    "build": "pnpm --filter @filescope/desktop build",
    "doctor": "node scripts/doctor.mjs",
    "format:rust:check": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all --check",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:bugfix": "pnpm check:version && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:v040-readiness": "node scripts/check-v040-readiness.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:properties": "pnpm --filter @filescope/desktop test:properties && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --locked properties",
    "check:readiness": "pnpm check:version && pnpm check:v040-readiness && pnpm test:properties"
  }
}
