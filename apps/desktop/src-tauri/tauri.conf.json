{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileScope",
  "version": "0.3.2",
  "identifier": "com.filescope.desktop",
  "build": {
    "beforeDevCommand": "pnpm icons && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm icons && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileScope 0.3.2",
        "width": 1280,
        "height": 820,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Veilbyte",
    "category": "Utility",
    "shortDescription": "Локальная проверка ссылок, файлов и архивов до запуска",
    "longDescription": "FileScope by Veilbyte — desktop-приложение для локального статического анализа файлов, URL и ZIP-архивов без запуска исследуемых объектов.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
