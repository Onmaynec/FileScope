{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileScope",
  "version": "0.1.0",
  "identifier": "com.filescope.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FileScope",
        "width": 1280,
        "height": 820,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Проверка ссылок, файлов и архивов до запуска",
    "longDescription": "FileScope — desktop-приложение для понятной локальной проверки объектов до запуска.",
    "windows": {
      "nsis": {
        "installMode": "perUser"
      }
    }
  }
}
